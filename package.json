{
  "name": "drawflare-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "wrangler dev --config wrangler.dev.toml",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "bun run check && bun run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply drawflare-db --local",
    "db:remote": "wrangler d1 migrations apply drawflare-db --remote"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "svelte": "^5.38.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.39.0"
  },
  "overrides": {
    "clsx": "^2.1.1"
  }
}