# Local development settings. Copy this file to .dev.vars for Wrangler's local Worker runtime.
# Leave secrets unset only when you intentionally want authentication disabled.
APP_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes
MCP_AUTH_TOKEN=replace-with-a-separate-mcp-token

# Optional: enable self-service password reset emails through Resend.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=DrawFlare <no-reply@your-verified-domain.example>

# Optional GitHub owner/repository used by the in-app update checker
# DRAWFLARE_GITHUB_REPO=your-org/drawflare
